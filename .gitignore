# Make blueprints: commit only sanitized copies
make/blueprints/*.json
!make/blueprints/*.sanitized.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
~$*
